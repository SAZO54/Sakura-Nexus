<header class="sn-header">
  <div class="sn-header__announcement">
    Free international shipping on orders over $80 &middot; Authentic goods direct from Japan &middot; Secure checkout
  </div>

  <div class="sn-header__inner">
    <a class="sn-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      Sakura Nexus
    </a>

    <nav class="sn-header__nav" aria-label="Main navigation">
      {% if section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" {% if request.path == routes.root_url %}aria-current="page"{% endif %}>Home</a>
        <a href="{{ routes.all_products_collection_url }}" {% if template.name == 'collection' %}aria-current="page"{% endif %}>Shop</a>
        <a href="{{ routes.collections_url }}" {% if template.name == 'list-collections' %}aria-current="page"{% endif %}>Collections</a>
        <a href="/pages/about" {% if page.handle == 'about' %}aria-current="page"{% endif %}>About</a>
        <a href="/pages/shipping-returns" {% if page.handle == 'shipping-returns' %}aria-current="page"{% endif %}>Shipping & Returns</a>
        <a href="/pages/faq" {% if page.handle == 'faq' %}aria-current="page"{% endif %}>FAQ</a>
        <a href="/pages/contact" {% if page.handle == 'contact' %}aria-current="page"{% endif %}>Contact</a>
      {% endif %}
    </nav>

    <div class="sn-header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="sn-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .sn-header {
    grid-column: 1 / -1;
    width: 100%;
    background: #fff;
    color: #1f1f1f;
    border-bottom: 0.0625rem solid #e5e7eb;
    font-family: var(--font-primary--family);
  }

  .sn-header__announcement {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.5rem;
    background: #e8a0bf;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
  }

  .sn-header__inner {
    width: var(--sn-wide-content-width);
    min-height: 5rem;
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .sn-header a {
    color: inherit;
    text-decoration: none;
  }

  .sn-header__brand {
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .sn-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.875rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sn-header__nav a {
    position: relative;
    padding: 1.875rem 0;
  }

  .sn-header__nav a[aria-current='page'] {
    color: #e8a0bf;
  }

  .sn-header__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 2.125rem;
    height: 0.125rem;
    border-radius: 62.44rem;
    background: #e8a0bf;
    transform: translateX(-50%);
  }

  .sn-header__icons {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .sn-header__icons svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .sn-header__cart {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 62.44rem;
    background: #fff5f8;
    border: 0.0625rem solid #e5e8eb;
  }

  .sn-header__cart span {
    position: absolute;
    top: -0.3125rem;
    right: -0.3125rem;
    min-width: 1.125rem;
    height: 1.125rem;
    display: grid;
    place-items: center;
    border-radius: 62.44rem;
    background: #e8a0bf;
    color: #fff;
    font-size: 0.625rem;
    font-weight: 800;
    line-height: 1;
  }

  @media (max-width: 56.25rem) {
    .sn-header__inner {
      width: calc(100% - 4rem);
      padding: 0;
      flex-wrap: wrap;
      gap: 0.625rem 1.25rem;
      min-height: auto;
      padding-block: 1.125rem;
    }

    .sn-header__nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 1.125rem;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }

    .sn-header__nav a {
      padding: 0.5rem 0;
      white-space: nowrap;
    }

    .sn-header__nav a[aria-current='page']::after {
      bottom: 0;
    }
  }

  @media (max-width: 45rem) {
    .sn-header__inner {
      width: calc(100% - 2.5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
