<header class="sn-header">
  <div class="sn-header__announcement">
    Free international shipping on orders over $80 &middot; Authentic goods direct from Japan &middot; Secure checkout
  </div>

  <div class="sn-header__inner">
    <a class="sn-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      Sakura Nexus
    </a>

    <nav class="sn-header__nav" aria-label="Main navigation">
      {% if section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" {% if request.path == routes.root_url %}aria-current="page"{% endif %}>Home</a>
        <a href="{{ routes.all_products_collection_url }}" {% if template.name == 'collection' %}aria-current="page"{% endif %}>Shop</a>
        <a href="{{ routes.collections_url }}" {% if template.name == 'list-collections' %}aria-current="page"{% endif %}>Collections</a>
        <a href="/pages/about" {% if page.handle == 'about' %}aria-current="page"{% endif %}>About</a>
        <a href="/pages/faq" {% if page.handle == 'faq' %}aria-current="page"{% endif %}>FAQ</a>
        <a href="/pages/contact" {% if page.handle == 'contact' %}aria-current="page"{% endif %}>Contact</a>
      {% endif %}
    </nav>

    <div class="sn-header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="sn-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .sn-header {
    grid-column: 1 / -1;
    width: 100%;
    background: #fff;
    color: #1f1f1f;
    border-bottom: 1px solid #e5e7eb;
    font-family: var(--font-primary--family);
  }

  .sn-header__announcement {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    background: #e8a0bf;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .sn-header__inner {
    width: calc(100% - 400px);
    min-height: 80px;
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .sn-header a {
    color: inherit;
    text-decoration: none;
  }

  .sn-header__brand {
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .sn-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    font-size: 14px;
    font-weight: 500;
  }

  .sn-header__nav a {
    position: relative;
    padding: 30px 0;
  }

  .sn-header__nav a[aria-current='page'] {
    color: #e8a0bf;
  }

  .sn-header__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 20px;
    width: 34px;
    height: 2px;
    border-radius: 999px;
    background: #e8a0bf;
    transform: translateX(-50%);
  }

  .sn-header__icons {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sn-header__icons svg {
    width: 20px;
    height: 20px;
  }

  .sn-header__cart {
    position: relative;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #fff5f8;
    border: 1px solid #e5e8eb;
  }

  .sn-header__cart span {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #e8a0bf;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .sn-header__inner {
      width: calc(100% - 64px);
      padding: 0;
      flex-wrap: wrap;
      gap: 10px 20px;
      min-height: auto;
      padding-block: 18px;
    }

    .sn-header__nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 18px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .sn-header__nav a {
      padding: 8px 0;
      white-space: nowrap;
    }

    .sn-header__nav a[aria-current='page']::after {
      bottom: 0;
    }
  }

  @media (max-width: 720px) {
    .sn-header__inner {
      width: calc(100% - 40px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
