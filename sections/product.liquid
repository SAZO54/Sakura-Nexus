{% javascript %}
  const quantityInput = document.querySelector('.sn-quantity-selector input');
  const minusButton = document.querySelector('[data-sn-quantity-minus]');
  const plusButton = document.querySelector('[data-sn-quantity-plus]');
  const variantSelect = document.querySelector('.sn-product-form select[name="id"]');
  const mainImage = document.querySelector('.sn-product-gallery__main img');
  const thumbs = document.querySelectorAll('[data-sn-product-thumb]');
  const saveButton = document.querySelector('[data-sn-save-product]');

  if (quantityInput && minusButton && plusButton) {
    const getMaxQuantity = () => {
      const max = Number(quantityInput.getAttribute('max'));
      return Number.isFinite(max) && max > 0 ? max : null;
    };

    const clampQuantity = (value) => {
      const min = Number(quantityInput.getAttribute('min')) || 1;
      const max = getMaxQuantity();
      let nextValue = Number(value || min);

      if (!Number.isFinite(nextValue)) nextValue = min;
      nextValue = Math.max(min, nextValue);
      if (max !== null) nextValue = Math.min(max, nextValue);

      quantityInput.value = String(nextValue);
      plusButton.disabled = max !== null && nextValue >= max;
      minusButton.disabled = nextValue <= min;
    };

    clampQuantity(quantityInput.value);

    minusButton.addEventListener('click', () => {
      clampQuantity(Number(quantityInput.value || 1) - 1);
    });

    plusButton.addEventListener('click', () => {
      clampQuantity(Number(quantityInput.value || 1) + 1);
    });

    quantityInput.addEventListener('change', () => {
      clampQuantity(quantityInput.value);
    });

    if (variantSelect) {
      variantSelect.addEventListener('change', () => {
        const selectedOption = variantSelect.selectedOptions[0];
        const maxQuantity = selectedOption ? selectedOption.dataset.inventoryQuantity : '';

        if (maxQuantity) {
          quantityInput.setAttribute('max', maxQuantity);
        } else {
          quantityInput.removeAttribute('max');
        }

        clampQuantity(quantityInput.value);
      });
    }
  }

  if (mainImage && thumbs.length) {
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (event) => {
        event.preventDefault();
        mainImage.src = thumb.href;
        thumbs.forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });
  }

  if (saveButton) {
    const key = `sn_saved_product_${saveButton.dataset.productId}`;
    const label = saveButton.querySelector('span:last-child');
    const icon = saveButton.querySelector('span:first-child');

    const syncSavedState = (saved) => {
      saveButton.setAttribute('aria-pressed', String(saved));
      if (label) label.textContent = saved ? 'Saved' : 'Save item';
      if (icon) icon.textContent = saved ? '❤' : '♡';
    };

    let isSaved = false;
    try {
      isSaved = localStorage.getItem(key) === 'true';
    } catch (error) {
      isSaved = false;
    }

    syncSavedState(isSaved);

    saveButton.addEventListener('click', () => {
      const nextSaved = saveButton.getAttribute('aria-pressed') !== 'true';
      try {
        localStorage.setItem(key, String(nextSaved));
      } catch (error) {
        // Keep the visual toggle even when persistent storage is unavailable.
      }
      syncSavedState(nextSaved);
    });
  }
{% endjavascript %}

