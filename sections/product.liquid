{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign condition = product.metafields.custom.condition.value | default: product.metafields.custom.condition
  assign series = product.metafields.custom.series.value | default: product.metafields.custom.series | default: 'ONE PIECE'
  assign character = product.metafields.custom.character.value | default: product.metafields.custom.character | default: 'Roronoa Zoro'
  assign release_region = product.metafields.custom.release_region.value | default: product.metafields.custom.release_region | default: 'Japan'
  assign item_notes = product.metafields.custom.item_notes.value | default: product.metafields.custom.item_notes | default: 'Stored in a personal collection.'
  assign item_type = product.type | default: 'Figure'

  if condition == blank
    if product.tags contains 'condition_opened'
      assign condition = 'Like New'
    elsif product.tags contains 'condition_used'
      assign condition = 'Good'
    else
      assign condition = 'New'
    endif
  endif
%}

<section class="sn-product-page full-width">
  <div class="sn-product-hero">
    <div class="sn-product-hero__inner">
      <nav class="sn-product-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <span>/</span>
        <span>{{ product.title | escape }}</span>
      </nav>

      <div class="sn-product-top">
        <div class="sn-product-gallery">
          <div class="sn-product-gallery__main">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'eager', alt: product.title }}
            {% else %}
              <img src="{{ 'sakura-product-zoro-dxf.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="536" height="536" loading="eager">
            {% endif %}
            {% render 'sn-condition-badge', product: product, class: 'sn-product-badge' %}
          </div>

          <div class="sn-product-thumbs" aria-label="Product images">
            {% if product.images.size > 0 %}
              {% for image in product.images limit: 4 %}
                <a
                  class="sn-product-thumb {% if forloop.first %}is-active{% endif %}"
                  href="{{ image | image_url: width: 1100 }}"
                  data-sn-product-thumb
                >
                  {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
                </a>
              {% endfor %}
            {% else %}
              {% for index in (1..4) %}
                <span class="sn-product-thumb {% if forloop.first %}is-active{% endif %}">Image</span>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <div class="sn-product-info">
          <p class="sn-product-series">{{ series }} &middot; {{ item_type }} &middot; Ships from Japan</p>
          <h1>{{ product.title | escape }}</h1>
          <p class="sn-product-price">{{ current_variant.price | money }}</p>
          <p class="sn-product-stock">
            {% if current_variant.available %}
              In Stock{% if current_variant.inventory_management and current_variant.inventory_quantity > 0 %} &middot; {{ current_variant.inventory_quantity }} item{% if current_variant.inventory_quantity != 1 %}s{% endif %} available{% endif %}
            {% else %}
              Sold Out
            {% endif %}
          </p>

          {% form 'product', product, class: 'sn-product-form' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">

            {% if product.variants.size > 1 %}
              <label class="sn-variant-label" for="ProductVariant-{{ section.id }}">Variant</label>
              <select id="ProductVariant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}

            <label class="sn-quantity-label" for="Quantity-{{ section.id }}">Quantity</label>
            <div class="sn-quantity-selector">
              <button type="button" data-sn-quantity-minus aria-label="Decrease quantity">-</button>
              <input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1" inputmode="numeric">
              <button type="button" data-sn-quantity-plus aria-label="Increase quantity">+</button>
            </div>

            <button class="sn-add-to-cart" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>

            <div class="sn-buy-now">
              {{ form | payment_button }}
            </div>
          {% endform %}

          <div class="sn-trust-notes">
            <p>100% Authentic</p>
            <p>Ships from Japan</p>
            <p>Secure Payment</p>
            <span>Import duties may apply depending on your country.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="sn-product-details">
    <div class="sn-product-details__intro">
      <p class="sn-eyebrow">Product details</p>
      <h2>Condition & item information</h2>
      <p>Official Japanese anime collectible sourced from a personal collection in Japan. Please review all photos and condition details before purchasing.</p>
    </div>

    <dl class="sn-spec-card">
      <div><dt>Series</dt><dd>{{ series }}</dd></div>
      <div><dt>Character</dt><dd>{{ character }}</dd></div>
      <div><dt>Item Type</dt><dd>{{ item_type }}</dd></div>
      <div><dt>Condition</dt><dd>{{ condition }}</dd></div>
      <div><dt>Region</dt><dd>{{ release_region }}</dd></div>
      <div><dt>Notes</dt><dd>{{ item_notes }}</dd></div>
    </dl>

    <div class="sn-description-card">
      <h3>Description template</h3>
      {% if product.description != blank %}
        <div class="sn-rte">{{ product.description }}</div>
      {% else %}
        <p>Official Japanese collectible.</p>
        <p>Condition: {{ condition }}</p>
        <p>Notes: {{ item_notes }}</p>
        <p>Shipping: Ships from Japan.</p>
      {% endif %}
    </div>

    <div class="sn-shipping-card">
      <h3>Shipping & customs</h3>
      <p>Items are shipped from Japan. Tracking availability and delivery time depend on destination country. Import duties, taxes, and customs fees may be charged by your country and are the buyer's responsibility.</p>
    </div>
  </section>

  <section class="sn-reviews">
    <div class="sn-reviews__inner">
      <p class="sn-eyebrow">Customer reviews</p>
      <h2>Customer Reviews</h2>
      <p class="sn-reviews__lead">Reviews from verified customers who purchased anime collectibles from Sakura Nexus.</p>

      <div class="sn-review-summary">
        <div>
          <strong>4.8</strong>
          <span>★★★★☆</span>
          <p>Based on 24 reviews</p>
        </div>
        <em>100% Verified Purchases</em>
      </div>

      <article class="sn-review-card sn-review-card--wide">
        <header>
          <div>
            <h3>Collector_JP</h3>
            <p>Verified Purchase</p>
          </div>
          <time datetime="2024-05-15">2024-05-15</time>
        </header>
        <div class="sn-review-card__rating">
          <span>★★★★★</span>
          <strong>Excellent Quality and Detail</strong>
        </div>
        <p>The item was carefully packed and arrived in great condition. The paint quality and details were even better than expected.</p>
      </article>

      <div class="sn-review-grid">
        <article class="sn-review-card">
          <header>
            <div>
              <h3>AnimeEnthusiast</h3>
              <p>Verified Purchase</p>
            </div>
            <time datetime="2024-05-10">2024-05-10</time>
          </header>
          <div class="sn-review-card__rating">
            <span>★★★★☆</span>
            <strong>Great Figure, Minor Paint Issues</strong>
          </div>
          <p>Beautiful figure overall. There were some minor imperfections, but nothing major for a collectible item.</p>
        </article>

        <article class="sn-review-card">
          <header>
            <div>
              <h3>ZoroFan</h3>
              <p>Verified Purchase</p>
            </div>
            <time datetime="2024-04-28">2024-04-28</time>
          </header>
          <div class="sn-review-card__rating">
            <span>★★★★★</span>
            <strong>Perfect Representation</strong>
          </div>
          <p>The packaging was secure and the product matched the photos. Worth every yen for Zoro collectors.</p>
        </article>
      </div>

      <a class="sn-review-link" href="#reviews">View All Reviews</a>
    </div>
  </section>

  <section class="sn-related">
    <div class="sn-related__heading">
      <div>
        <p class="sn-eyebrow">Related items</p>
        <h2>You may also like</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}">View All &rarr;</a>
    </div>

    <div class="sn-related-grid">
      {% assign related_count = 0 %}
      {% for related_product in collections.all.products limit: 8 %}
        {% if related_product.id != product.id and related_count < 4 %}
          {% assign related_count = related_count | plus: 1 %}
          {% render 'sn-product-card',
            product: related_product,
            card_class: 'sn-related-card',
            image_class: 'sn-related-card__image',
            price_class: 'sn-related-card__price',
            stock_class: 'sn-related-card__stock',
            image_width: 520,
            show_badge: false
          %}
        {% endif %}
      {% endfor %}

      {% if related_count == 0 %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-card-set.jpg', badge: 'Good', title: 'ONE PIECE Card Set SP', price: '$36.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-nami-badge.jpg', badge: 'Very Good', title: 'Nami Pin Badge Collection', price: '$14.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-luffy-acrylic.jpg', badge: 'Like New', title: 'Luffy Acrylic Stand Set', price: '$22.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-feature-nami-dxf.jpg', badge: 'New', title: 'Nami DXF Figure Vol.3', price: '$42.00' %}
      {% endif %}
    </div>
  </section>

  {% render 'sn-faq-cta',
    class: 'sn-product-faq',
    heading: 'Questions before ordering?',
    text: 'Learn about authenticity, shipping, customs, and payment methods.',
    url: '/pages/faq',
    label: 'View FAQ'
  %}
</section>

{% stylesheet %}
  .sn-product-page {
    --sn-pink: #e8a1bf;
    --sn-pink-soft: #fff5f7;
    --sn-pink-strong: #d67da6;
    --sn-ink: #1f1f1f;
    --sn-muted: #6b7380;
    --sn-body: #384052;
    --sn-line: #e5e8eb;
    --sn-cream: #faf7f2;
    font-family: var(--font-primary--family);
    color: var(--sn-ink);
    background: #fff;
  }

  .sn-product-page a {
    color: inherit;
    text-decoration: none;
  }

  .sn-product-hero {
    position: relative;
    overflow: hidden;
    background: var(--sn-cream);
  }

  .sn-product-hero::after {
    content: '';
    position: absolute;
    top: -0.875rem;
    right: -1.25rem;
    width: 17.5rem;
    height: 17.5rem;
    border-radius: 62.44rem;
    background: rgba(232, 161, 191, 0.16);
  }

  .sn-product-hero__inner {
    position: relative;
    z-index: 1;
    width: var(--sn-wide-content-width);
    margin: 0 auto;
    padding: 2rem 0 3.75rem;
  }

  .sn-product-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5625rem;
    color: var(--sn-muted);
    font-size: 0.8125rem;
  }

  .sn-product-top {
    display: grid;
    grid-template-columns: minmax(0, 33.5rem) minmax(0, 35.38rem);
    gap: 2.125rem;
    margin-top: 1.625rem;
  }

  .sn-product-gallery__main {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 1.25rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 1.5rem;
    background: #fff;
  }

  .sn-product-gallery__main img,
  .sn-product-gallery__main svg {
    width: 100%;
    height: 100%;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  .sn-product-badge {
    position: absolute;
    top: 2.25rem;
    left: 2.25rem;
    min-height: 1.562rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.625rem;
    border-radius: 0.375rem;
    background: var(--sn-pink);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-product-badge--like-new,
  .sn-product-badge--opened {
    background: #f4c7d9;
    color: #7a294d;
  }

  .sn-product-badge--good,
  .sn-product-badge--used {
    background: #7c9f32;
    color: #fff;
  }

  .sn-product-badge--very-good {
    background: #cee8ce;
    color: #215a21;
  }

  .sn-product-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .sn-product-thumb {
    width: 5.75rem;
    height: 5.75rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.75rem;
    background: #fff;
    color: var(--sn-muted);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .sn-product-thumb.is-active {
    border-color: var(--sn-pink);
  }

  .sn-product-thumb img {
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 0.625rem;
    object-fit: cover;
  }

  .sn-product-info {
    padding: 1.125rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .sn-product-series,
  .sn-eyebrow {
    color: var(--sn-pink-strong);
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-product-info h1 {
    max-width: 31.25rem;
    margin-top: 1rem;
    font-size: 2.375rem;
    line-height: 1.14;
    font-weight: 800;
  }

  .sn-product-price {
    margin-top: 3rem;
    font-size: 2.125rem;
    line-height: 1.2;
    font-weight: 800;
  }

  .sn-product-stock {
    margin-top: 0.375rem;
    color: #6b8f24;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .sn-product-form {
    margin-top: 2.75rem;
  }

  .sn-variant-label,
  .sn-quantity-label {
    display: block;
    margin-bottom: 0.625rem;
    color: var(--sn-body);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .sn-product-form select {
    width: 100%;
    min-height: 2.75rem;
    margin-bottom: 1.125rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .sn-quantity-selector {
    width: 8.25rem;
    height: 2.75rem;
    display: grid;
    grid-template-columns: 2.5rem 3.25rem 2.5rem;
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .sn-quantity-selector button,
  .sn-quantity-selector input {
    border: 0;
    background: transparent;
    color: var(--sn-ink);
    font: inherit;
    font-weight: 800;
    text-align: center;
  }

  .sn-quantity-selector input::-webkit-outer-spin-button,
  .sn-quantity-selector input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sn-add-to-cart {
    width: 100%;
    min-height: 3.375rem;
    margin-top: 1.5rem;
    border: 0.0625rem solid var(--sn-pink);
    border-radius: 0.375rem;
    background: var(--sn-pink);
    color: #fff;
    font-family: inherit;
    font-size: 1.25rem;
    font-weight: 800;
    cursor: pointer;
  }

  .sn-add-to-cart:disabled {
    border-color: #d1d5db;
    background: #d1d5db;
    cursor: not-allowed;
  }

  .sn-buy-now {
    margin-top: 0.875rem;
  }

  .sn-buy-now .shopify-payment-button__button {
    min-height: 3.375rem;
    border: 0.0625rem solid var(--sn-pink) !important;
    border-radius: 0.375rem !important;
    background: #fff !important;
    color: var(--sn-pink) !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
  }

  .sn-trust-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
    padding: 1.125rem 1.25rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: var(--sn-pink-soft);
  }

  .sn-trust-notes p {
    color: var(--sn-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .sn-trust-notes p::before {
    content: '\2713';
    margin-right: 0.5rem;
  }

  .sn-trust-notes span {
    grid-column: 1 / -1;
    color: var(--sn-muted);
    font-size: 0.75rem;
  }

  .sn-product-details {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
    padding: 3.5rem 0 4.5rem;
    display: grid;
    grid-template-columns: minmax(0, 35rem) minmax(0, 30.5rem);
    gap: 2.625rem 5.5rem;
  }

  .sn-product-details__intro h2 {
    margin-top: 0.75rem;
    font-size: 1.875rem;
    line-height: 1.2;
  }

  .sn-product-details__intro p:not(.sn-eyebrow) {
    margin-top: 0.875rem;
    color: var(--sn-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .sn-spec-card {
    display: grid;
    gap: 0;
    padding: 1.5rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
  }

  .sn-spec-card div {
    display: grid;
    grid-template-columns: 8.125rem 1fr;
    gap: 0.75rem;
    padding: 0.625rem 0;
    font-size: 0.8125rem;
  }

  .sn-spec-card dt {
    color: var(--sn-muted);
    font-weight: 600;
  }

  .sn-spec-card dd {
    font-weight: 800;
  }

  .sn-description-card,
  .sn-shipping-card {
    padding: 1.5rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: var(--sn-pink-soft);
  }

  .sn-description-card {
    min-height: 18.75rem;
  }

  .sn-shipping-card {
    align-self: end;
    min-height: 9.75rem;
  }

  .sn-description-card h3,
  .sn-shipping-card h3 {
    font-size: 1.125rem;
  }

  .sn-description-card p,
  .sn-shipping-card p,
  .sn-rte {
    margin-top: 0.875rem;
    color: var(--sn-body);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .sn-reviews {
    background: var(--sn-cream);
  }

  .sn-reviews__inner {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
    padding: 5.5rem 0 4.75rem;
  }

  .sn-reviews h2 {
    margin-top: 0.625rem;
    font-size: 2rem;
  }

  .sn-reviews__lead {
    margin-top: 0.625rem;
    color: var(--sn-body);
    font-size: 0.875rem;
  }

  .sn-review-summary {
    min-height: 10.19rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.75rem 2rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: var(--sn-pink-soft);
  }

  .sn-review-summary strong {
    display: block;
    color: var(--sn-pink);
    font-size: 2.375rem;
  }

  .sn-review-summary span {
    display: block;
    margin-top: 0.25rem;
    color: var(--sn-pink);
    font-size: 1.125rem;
    font-weight: 800;
  }

  .sn-review-summary p {
    margin-top: 0.5rem;
    color: var(--sn-body);
    font-size: 0.8125rem;
  }

  .sn-review-summary em {
    min-height: 2.875rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.75rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
    color: #6b8f24;
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 800;
  }

  .sn-review-card {
    padding: 1.5rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
  }

  .sn-review-card--wide {
    margin-top: 2.25rem;
  }

  .sn-review-card header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .sn-review-card h3 {
    font-size: 0.9375rem;
  }

  .sn-review-card header p {
    margin-top: 0.25rem;
    color: #6b8f24;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .sn-review-card time {
    color: var(--sn-muted);
    font-size: 0.75rem;
  }

  .sn-review-card__rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .sn-review-card__rating span {
    color: var(--sn-pink);
    font-size: 1.125rem;
    font-weight: 800;
  }

  .sn-review-card__rating strong {
    font-size: 1rem;
  }

  .sn-review-card > p {
    margin-top: 0.75rem;
    color: var(--sn-body);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .sn-review-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 2.25rem;
  }

  .sn-review-link {
    min-height: 2.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 11.25rem;
    margin: 2.25rem auto 0;
    border: 0.0625rem solid var(--sn-pink);
    border-radius: 0.375rem;
    color: var(--sn-pink);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .sn-related {
    padding: 4rem 0 3.375rem;
    background: #fff;
  }

  .sn-related__heading,
  .sn-related-grid {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
  }

  .sn-related__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .sn-related__heading h2 {
    margin-top: 0.75rem;
    font-size: 1.875rem;
  }

  .sn-related__heading > a {
    color: var(--sn-pink-strong);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .sn-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--sn-product-card-min-width, 14.7rem)), 1fr));
    gap: var(--sn-product-card-gap, 1.5rem);
    justify-content: stretch;
    justify-items: stretch;
    margin-top: 2.125rem;
  }

  .sn-related-card {
    display: block;
    width: 100%;
    max-width: var(--sn-product-card-max-width, 18.75rem);
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
  }

  .sn-related-card__image {
    position: relative;
    height: 13.12rem;
    display: block;
    overflow: hidden;
    background: #f4f4f5;
  }

  .sn-related-card__image img,
  .sn-related-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-related-card h3 {
    min-height: 2.375rem;
    margin: 1.125rem 1.125rem 0;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .sn-related-card__price {
    margin: 0.75rem 1.125rem 0;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .sn-related-card__stock {
    margin: 0.25rem 1.125rem 0;
    color: #6b7280;
    font-size: 0.75rem;
  }

  .sn-related-card .sn-card-button {
    width: calc(100% - 2.25rem);
    margin: 2.625rem 1.125rem 1.25rem;
  }

  .sn-card-button {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0.125rem solid var(--sn-pink);
    border-radius: 0.375rem;
    color: var(--sn-pink);
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: 0 0.25rem 0.25rem rgba(232, 160, 191, 0.18);
  }

  .sn-product-faq {
    padding: 3.625rem 1.25rem 3.375rem;
    background: var(--sn-cream);
    text-align: center;
  }

  .sn-product-faq h2 {
    font-size: 1.75rem;
  }

  .sn-product-faq p {
    margin-top: 0.625rem;
    color: var(--sn-body);
    font-size: 0.875rem;
  }

  .sn-product-faq a {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.25rem;
    padding: 0 1.875rem;
    border-radius: 0.375rem;
    background: var(--sn-pink);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
  }

  @media (max-width: 73.75rem) {
    .sn-product-hero__inner,
    .sn-product-details,
    .sn-reviews__inner,
    .sn-related__heading,
    .sn-related-grid {
      width: calc(100% - 4rem);
    }

    .sn-product-top,
    .sn-product-details {
      grid-template-columns: 1fr;
    }

    .sn-product-gallery {
      max-width: 38.75rem;
    }

    .sn-shipping-card {
      align-self: stretch;
    }

  }

  @media (max-width: 45rem) {
    .sn-product-hero__inner,
    .sn-product-details,
    .sn-reviews__inner,
    .sn-related__heading,
    .sn-related-grid {
      width: calc(100% - 2.5rem);
    }

    .sn-product-info h1 {
      font-size: 2rem;
    }

    .sn-product-price {
      margin-top: 1.75rem;
    }

    .sn-trust-notes,
    .sn-review-grid,
    .sn-related-grid {
      grid-template-columns: 1fr;
    }

    .sn-related-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sn-review-summary,
    .sn-related__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .sn-review-card__rating {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sn-spec-card div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  const quantityInput = document.querySelector('.sn-quantity-selector input');
  const minusButton = document.querySelector('[data-sn-quantity-minus]');
  const plusButton = document.querySelector('[data-sn-quantity-plus]');
  const mainImage = document.querySelector('.sn-product-gallery__main img');
  const thumbs = document.querySelectorAll('[data-sn-product-thumb]');

  if (quantityInput && minusButton && plusButton) {
    minusButton.addEventListener('click', () => {
      const value = Math.max(1, Number(quantityInput.value || 1) - 1);
      quantityInput.value = String(value);
    });

    plusButton.addEventListener('click', () => {
      quantityInput.value = String(Number(quantityInput.value || 1) + 1);
    });
  }

  if (mainImage && thumbs.length) {
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (event) => {
        event.preventDefault();
        mainImage.src = thumb.href;
        thumbs.forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });
  }
{% endjavascript %}

