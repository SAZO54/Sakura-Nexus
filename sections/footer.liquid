<footer class="sn-footer">
  <div class="sn-footer__inner">
    <div class="sn-footer__brand">
      <a href="{{ routes.root_url }}">Sakura Nexus</a>
      <p>Authentic Anime Goods from Japan</p>
    </div>

    <nav class="sn-footer__nav" aria-label="Footer navigation">
      <div>
        <h2>Shop</h2>
        <a href="{{ routes.all_products_collection_url }}">All Items</a>
        <a href="{{ routes.collections_url }}/one-piece">ONE PIECE</a>
        <a href="{{ routes.collections_url }}/figures">Figures</a>
        <a href="{{ routes.collections_url }}/acrylic-stands">Acrylic Stands</a>
        <a href="{{ routes.collections_url }}/badges">Badges</a>
      </div>
      <div>
        <h2>Info</h2>
        <a href="/pages/about">About Us</a>
        <a href="/pages/shipping-returns">Shipping & Returns</a>
        <a href="/policies/shipping-policy">Shipping Policy</a>
        <a href="/pages/faq">FAQ</a>
        <a href="/pages/contact">Contact</a>
      </div>
      <div>
        <h2>Legal</h2>
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
      </div>
    </nav>

    <div class="sn-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} Sakura Nexus. All rights reserved.</p>
      {% if section.settings.show_payment_icons %}
        <div class="sn-footer__payment" aria-label="Accepted payment methods">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .sn-footer {
    grid-column: 1 / -1;
    background: #1f1f1f;
    color: #fff;
    font-family: var(--font-primary--family);
  }

  .sn-footer__inner {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
    padding: 4rem 0 1.75rem;
  }

  .sn-footer a {
    color: inherit;
    text-decoration: none;
  }

  .sn-footer__inner {
    display: grid;
    grid-template-columns: 1fr 43rem;
    gap: 3.5rem;
  }

  .sn-footer__brand a {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .sn-footer__brand p {
    margin-top: 0.875rem;
    color: #6b7280;
    font-size: 0.8125rem;
  }

  .sn-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .sn-footer__nav h2 {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .sn-footer__nav a {
    display: block;
    width: fit-content;
    margin-top: 0.8125rem;
    color: #999;
    font-size: 0.8125rem;
  }

  .sn-footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.75rem;
    padding-top: 1.375rem;
    border-top: 0.0625rem solid #404040;
    color: #737373;
    font-size: 0.75rem;
  }

  .sn-footer__payment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sn-footer__payment svg {
    width: 2rem;
    height: auto;
  }

  @media (max-width: 56.25rem) {
    .sn-footer__inner {
      width: calc(100% - 4rem);
      padding: 3rem 0 1.75rem;
      grid-template-columns: 1fr;
    }

    .sn-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sn-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 35rem) {
    .sn-footer__inner {
      width: calc(100% - 2.5rem);
    }

    .sn-footer__nav {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
