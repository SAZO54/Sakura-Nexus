<section class="sn-collections full-width">
  {% render 'sn-section-heading',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading
  %}

  <div class="sn-collection-links-grid">
    {% for block in section.blocks %}
      <a class="sn-collection-links-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 520 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
        {% elsif block.settings.asset_name != blank %}
          <img src="{{ block.settings.asset_name | asset_url }}" alt="" width="205" height="160" loading="lazy">
        {% endif %}
        <strong>{{ block.settings.title }}</strong>
        {% if block.settings.text != blank %}
          <span>{{ block.settings.text }}</span>
        {% endif %}
        <b aria-hidden="true">-&gt;</b>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .sn-collections {
    --sn-pink: #e8a0bf;
    --sn-pink-strong: #d67ca7;
    --sn-ink: #1f1f1f;
    --sn-muted: #6b7280;
    --sn-line: #e5e7eb;
    --sn-content-width: 80rem;
    padding-block: 4.625rem 5.125rem;
    background: #fff;
    color: var(--sn-ink);
    font-family: var(--font-primary--family);
  }

  .sn-collections a {
    color: inherit;
    text-decoration: none;
  }

  .sn-collection-links-grid {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .sn-collection-links-card {
    position: relative;
    min-height: 10rem;
    overflow: hidden;
    padding: 2.625rem 1.125rem 1.125rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.5rem;
    background: #fff5f8;
  }

  .sn-collection-links-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }

  .sn-collection-links-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255, 245, 248, 0.96), rgba(255, 245, 248, 0.72) 52%, rgba(255, 245, 248, 0.14));
  }

  .sn-collection-links-card strong,
  .sn-collection-links-card span,
  .sn-collection-links-card b {
    position: relative;
    z-index: 1;
    display: block;
  }

  .sn-collection-links-card strong {
    font-size: 0.9375rem;
  }

  .sn-collection-links-card span {
    margin-top: 0.75rem;
    color: var(--sn-muted);
    font-size: 0.75rem;
  }

  .sn-collection-links-card b {
    position: absolute;
    right: 1.25rem;
    bottom: 1.5rem;
    color: var(--sn-pink);
    font-size: 1rem;
  }

  @media (max-width: 68.75rem) {
    .sn-collection-links-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 45rem) {
    .sn-collections {
      padding-block: 3.5rem;
    }

    .sn-collection-links-grid {
      width: calc(100% - 2.5rem);
      grid-template-columns: 1fr;
    }

    .sn-collection-links-card {
      min-height: 9rem;
    }
  }
{% endstylesheet %}

