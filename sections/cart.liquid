<section class="sn-cart-page full-width">
  <div class="sn-cart-hero">
    <div class="sn-cart-hero__inner">
      <nav class="sn-cart-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <span>Cart</span>
      </nav>

      <div class="sn-cart-title-row">
        <h1>Your Cart</h1>
        <span>{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
      </div>

      <p>Review your items before checkout. Shipping and taxes are calculated at checkout.</p>
    </div>
  </div>

  <div class="sn-cart-main">
    <div class="sn-cart-main__heading">
      <h2>Cart Items</h2>
      <a href="{{ routes.all_products_collection_url }}">Continue Shopping &rarr;</a>
    </div>

    <div class="sn-cart-layout">
      <div class="sn-cart-items">
        {% if cart.item_count > 0 %}
          <form class="sn-cart-form" action="{{ routes.cart_url }}" method="post">
            {% for item in cart.items %}
              {% liquid
                assign condition = item.product.metafields.custom.condition.value | default: item.product.metafields.custom.condition
                assign series = item.product.metafields.custom.series.value | default: item.product.metafields.custom.series | default: 'ONE PIECE'
                assign item_type = item.product.type | default: 'Anime Goods'

                if condition == blank
                  if item.product.tags contains 'condition_opened'
                    assign condition = 'Like New'
                  elsif item.product.tags contains 'condition_used'
                    assign condition = 'Good'
                  else
                    assign condition = 'New'
                  endif
                endif
              %}

              <article class="sn-cart-item">
                <a class="sn-cart-item__image" href="{{ item.url }}">
                  {% if item.image %}
                    {{ item.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </a>

                <div class="sn-cart-item__content">
                  <span class="sn-cart-badge sn-cart-badge--{{ condition | handleize }}">{{ condition }}</span>
                  <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                  <p>{{ item_type }} &middot; {{ series }} &middot; {{ condition }}</p>
                  <strong>
                    {% if item.variant.available %}
                      In Stock
                    {% else %}
                      Sold Out
                    {% endif %}
                  </strong>
                </div>

                <div class="sn-cart-quantity">
                  <button type="button" data-sn-cart-minus aria-label="Decrease quantity">-</button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    data-sn-cart-quantity
                    aria-label="Quantity for {{ item.product.title | escape }}"
                  >
                  <button type="button" data-sn-cart-plus aria-label="Increase quantity">+</button>
                </div>

                <p class="sn-cart-item__price">{{ item.final_line_price | money }}</p>
                <a class="sn-cart-remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }}">&times;</a>
              </article>
            {% endfor %}

            <button class="sn-cart-update" type="submit" name="update">Update cart</button>
          </form>
        {% else %}
          <div class="sn-cart-empty">
            <h3>Your cart is currently empty.</h3>
            <p>Items you add to your cart will appear here before checkout.</p>
            <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
          </div>
        {% endif %}

        <div class="sn-cart-empty-note">
          <h3>Empty cart state</h3>
          <p>If the cart has no items, show: "Your cart is currently empty." and guide users back to the product listing page.</p>
          <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
          <span>This block is a design note for implementation.</span>
        </div>
      </div>

      <aside class="sn-order-column">
        <form class="sn-order-summary" action="{{ routes.cart_url }}" method="post">
          <h2>Order Summary</h2>
          <dl>
            <div>
              <dt>Subtotal</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
            <div>
              <dt>Shipping</dt>
              <dd>Calculated at checkout</dd>
            </div>
            <div>
              <dt>Taxes / Customs</dt>
              <dd>May apply</dd>
            </div>
            <div class="sn-order-summary__total">
              <dt>Total</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
          </dl>

          <button type="submit" name="checkout" {% if cart.item_count == 0 %}disabled{% endif %}>Proceed to Checkout</button>
          <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
        </form>

        <div class="sn-checkout-notes">
          <h2>Before checkout</h2>
          <p>100% Authentic goods</p>
          <p>Ships from Japan</p>
          <p>Import duties may apply</p>
        </div>
      </aside>
    </div>
  </div>

  <section class="sn-cart-related">
    <div class="sn-cart-related__heading">
      <div>
        <p class="sn-eyebrow">Related items</p>
        <h2>You may also like</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}">View All &rarr;</a>
    </div>

    <div class="sn-cart-related__grid">
      {% assign related_count = 0 %}
      {% for related_product in collections.all.products limit: 8 %}
        {% if related_count < 4 %}
          {% assign related_count = related_count | plus: 1 %}
          {% render 'sn-product-card',
            product: related_product,
            card_class: 'sn-cart-related-card',
            image_class: 'sn-cart-related-card__image',
            price_class: 'sn-cart-related-card__price',
            stock_class: 'sn-cart-related-card__stock',
            image_width: 520,
            show_badge: false
          %}
        {% endif %}
      {% endfor %}

      {% if related_count == 0 %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-card-set.jpg', badge: 'Good', title: 'ONE PIECE Card Set SP', price: '$36.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-nami-badge.jpg', badge: 'Very Good', title: 'Nami Pin Badge Collection', price: '$14.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-product-luffy-acrylic.jpg', badge: 'Like New', title: 'Luffy Acrylic Stand Set', price: '$22.00' %}
        {% render 'sn-related-placeholder', asset_name: 'sakura-feature-nami-dxf.jpg', badge: 'New', title: 'Nami DXF Figure Vol.3', price: '$42.00' %}
      {% endif %}
    </div>
  </section>

  {% render 'sn-faq-cta',
    class: 'sn-cart-faq',
    heading: 'Questions before ordering?',
    text: 'Learn about authenticity, shipping, customs, and payment methods.',
    url: '/pages/faq',
    label: 'View FAQ'
  %}
</section>

{% stylesheet %}
  .sn-cart-page {
    --sn-pink: #e8a1bf;
    --sn-pink-soft: #fff5f8;
    --sn-pink-strong: #d67da6;
    --sn-ink: #1f1f1f;
    --sn-muted: #6b7380;
    --sn-body: #384052;
    --sn-line: #e5e8eb;
    --sn-cream: #faf7f2;
    font-family: var(--font-primary--family);
    color: var(--sn-ink);
    background: #fff;
  }

  .sn-cart-page a {
    text-decoration: none;
  }

  .sn-cart-hero {
    position: relative;
    overflow: hidden;
    background: var(--sn-cream);
  }

  .sn-cart-hero::after {
    content: '';
    position: absolute;
    top: -40px;
    right: -20px;
    width: 220px;
    height: 220px;
    border-radius: 999px;
    background: rgba(232, 161, 191, 0.16);
  }

  .sn-cart-hero__inner {
    position: relative;
    z-index: 1;
    width: calc(100% - 400px);
    min-height: 164px;
    margin: 0 auto;
    padding: 28px 0 34px;
  }

  .sn-cart-breadcrumb {
    display: flex;
    gap: 9px;
    color: var(--sn-muted);
    font-size: 13px;
  }

  .sn-cart-title-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 12px;
  }

  .sn-cart-title-row h1 {
    font-size: 44px;
    line-height: 1.05;
    font-weight: 800;
  }

  .sn-cart-title-row span {
    color: var(--sn-muted);
    font-size: 14px;
    font-weight: 600;
  }

  .sn-cart-hero__inner > p {
    margin-top: 8px;
    color: var(--sn-body);
    font-size: 14px;
  }

  .sn-cart-main {
    background: #fff;
  }

  .sn-cart-main__heading,
  .sn-cart-layout {
    width: calc(100% - 400px);
    margin: 0 auto;
  }

  .sn-cart-main__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 56px;
  }

  .sn-cart-main__heading h2 {
    font-size: 24px;
    line-height: 1.25;
  }

  .sn-cart-main__heading a {
    color: var(--sn-pink-strong);
    font-size: 13px;
    font-weight: 800;
  }

  .sn-cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1070px) minmax(320px, 400px);
    gap: 40px;
    padding: 28px 0 54px;
  }

  .sn-cart-form {
    display: grid;
    gap: 20px;
  }

  .sn-cart-item {
    position: relative;
    min-height: 172px;
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr) 116px 118px;
    gap: 18px;
    align-items: center;
    padding: 23px;
    border: 1px solid var(--sn-line);
    border-radius: 6px;
    background: #fff;
  }

  .sn-cart-item__image {
    width: 124px;
    height: 124px;
    display: block;
    overflow: hidden;
    border: 1px solid var(--sn-line);
    border-radius: 14px;
    background: #f5f7fa;
  }

  .sn-cart-item__image img,
  .sn-cart-item__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-cart-badge {
    min-height: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    padding: 0 10px;
    border-radius: 6px;
    background: var(--sn-pink);
    color: #fff;
    font-size: 11px;
    line-height: 1;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-cart-badge--like-new,
  .sn-cart-badge--opened {
    background: #f4c7d9;
    color: #7a294d;
  }

  .sn-cart-badge--good,
  .sn-cart-badge--used {
    background: #7c9f32;
    color: #fff;
  }

  .sn-cart-badge--very-good {
    background: #cee8ce;
    color: #215a21;
  }

  .sn-cart-item h3 {
    font-size: 16px;
    line-height: 1.35;
  }

  .sn-cart-item__content p {
    margin-top: 6px;
    color: var(--sn-muted);
    font-size: 13px;
  }

  .sn-cart-item__content strong {
    display: block;
    margin-top: 8px;
    color: #6b8f24;
    font-size: 12px;
  }

  .sn-cart-quantity {
    width: 116px;
    height: 40px;
    display: grid;
    grid-template-columns: 34px 48px 34px;
    overflow: hidden;
    border: 1px solid var(--sn-line);
    border-radius: 12px;
    background: #fff;
  }

  .sn-cart-quantity button,
  .sn-cart-quantity input {
    border: 0;
    background: transparent;
    color: var(--sn-ink);
    font: inherit;
    font-weight: 800;
    text-align: center;
  }

  .sn-cart-quantity input::-webkit-outer-spin-button,
  .sn-cart-quantity input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sn-cart-item__price {
    justify-self: end;
    font-size: 24px;
    font-weight: 800;
  }

  .sn-cart-remove {
    position: absolute;
    top: 20px;
    right: 18px;
    color: #e8a1bf;
    font-size: 22px;
    line-height: 1;
  }

  .sn-cart-update {
    justify-self: start;
    min-height: 42px;
    padding: 0 22px;
    border: 1px solid var(--sn-pink);
    border-radius: 6px;
    background: #fff;
    color: var(--sn-pink-strong);
    font-family: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .sn-cart-empty,
  .sn-cart-empty-note {
    width: 100%;
    padding: 24px;
    border: 1px solid var(--sn-line);
    border-radius: 6px;
    background: var(--sn-pink-soft);
  }

  .sn-cart-empty {
    min-height: 188px;
  }

  .sn-cart-empty-note {
    margin-top: 20px;
  }

  .sn-cart-empty h3,
  .sn-cart-empty-note h3 {
    font-size: 20px;
  }

  .sn-cart-empty p,
  .sn-cart-empty-note p {
    max-width: none;
    margin-top: 12px;
    color: var(--sn-body);
    font-size: 13px;
    line-height: 1.5;
  }

  .sn-cart-empty a,
  .sn-cart-empty-note a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    padding: 0 28px;
    border-radius: 6px;
    background: var(--sn-pink);
    color: #fff;
    font-weight: 800;
  }

  .sn-cart-empty-note span {
    display: inline-block;
    margin-left: 18px;
    color: var(--sn-muted);
    font-size: 12px;
  }

  .sn-order-column {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .sn-order-summary,
  .sn-checkout-notes {
    border: 1px solid var(--sn-line);
    border-radius: 6px;
    background: #fff;
  }

  .sn-order-summary {
    padding: 24px;
  }

  .sn-order-summary h2,
  .sn-checkout-notes h2 {
    font-size: 22px;
    line-height: 1.2;
  }

  .sn-order-summary dl {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--sn-line);
  }

  .sn-order-summary div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 11px 0;
    color: var(--sn-body);
    font-size: 14px;
  }

  .sn-order-summary dd {
    color: var(--sn-muted);
    text-align: right;
  }

  .sn-order-summary div:first-child dd,
  .sn-order-summary__total dd,
  .sn-order-summary__total dt {
    color: var(--sn-ink);
    font-weight: 800;
  }

  .sn-order-summary__total {
    margin-top: 12px;
    padding-top: 22px !important;
    border-top: 1px solid var(--sn-line);
    font-size: 16px !important;
  }

  .sn-order-summary__total dd {
    font-size: 24px;
  }

  .sn-order-summary button,
  .sn-order-summary > a {
    width: 100%;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 800;
  }

  .sn-order-summary button {
    margin-top: 18px;
    border: 1px solid var(--sn-pink);
    background: var(--sn-pink);
    color: #fff;
    cursor: pointer;
  }

  .sn-order-summary button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .sn-order-summary > a {
    min-height: 44px;
    margin-top: 12px;
    border: 1px solid var(--sn-pink);
    color: var(--sn-pink-strong);
  }

  .sn-checkout-notes {
    padding: 24px;
    background: var(--sn-pink-soft);
  }

  .sn-checkout-notes p {
    margin-top: 12px;
    color: var(--sn-body);
    font-size: 13px;
  }

  .sn-checkout-notes p::before {
    content: '\2713';
    margin-right: 8px;
  }

  .sn-cart-related {
    padding: 64px 0 72px;
    background: var(--sn-cream);
  }

  .sn-cart-related__heading,
  .sn-cart-related__grid {
    width: calc(100% - 400px);
    margin: 0 auto;
  }

  .sn-cart-related__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .sn-eyebrow {
    color: var(--sn-pink-strong);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-cart-related__heading h2 {
    margin-top: 12px;
    font-size: 30px;
  }

  .sn-cart-related__heading > a {
    color: var(--sn-pink-strong);
    font-size: 13px;
    font-weight: 800;
  }

  .sn-cart-related__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    margin-top: 34px;
  }

  .sn-cart-related-card,
  .sn-cart-related__grid .sn-related-card {
    overflow: hidden;
    border: 1px solid var(--sn-line);
    border-radius: 6px;
    background: #fff;
  }

  .sn-cart-related-card__image,
  .sn-cart-related__grid .sn-related-card__image {
    position: relative;
    height: 210px;
    display: block;
    overflow: hidden;
    background: #f4f4f5;
  }

  .sn-cart-related-card__image img,
  .sn-cart-related-card__image svg,
  .sn-cart-related__grid .sn-related-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-cart-related-card h3,
  .sn-cart-related__grid .sn-related-card h3 {
    min-height: 38px;
    margin: 18px 18px 0;
    font-size: 14px;
    line-height: 1.35;
  }

  .sn-cart-related-card__price,
  .sn-cart-related__grid .sn-related-card__price {
    margin: 12px 18px 0;
    font-size: 20px;
    font-weight: 800;
  }

  .sn-cart-related-card__stock,
  .sn-cart-related__grid .sn-related-card__stock {
    margin: 4px 18px 0;
    color: #6b7280;
    font-size: 12px;
  }

  .sn-card-button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(100% - 36px);
    margin: 42px 18px 20px;
    border: 2px solid var(--sn-pink);
    border-radius: 6px;
    color: var(--sn-pink);
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 4px 4px rgba(232, 160, 191, 0.18);
  }

  .sn-cart-faq {
    padding: 58px 20px 54px;
    background: #fff;
    text-align: center;
  }

  .sn-cart-faq h2 {
    font-size: 28px;
  }

  .sn-cart-faq p {
    margin-top: 10px;
    color: var(--sn-body);
    font-size: 14px;
  }

  .sn-cart-faq a {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    padding: 0 30px;
    border-radius: 6px;
    background: var(--sn-pink);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }

  @media (max-width: 1180px) {
    .sn-cart-hero__inner,
    .sn-cart-main__heading,
    .sn-cart-layout,
    .sn-cart-related__heading,
    .sn-cart-related__grid {
      width: calc(100% - 64px);
    }

    .sn-cart-layout {
      grid-template-columns: 1fr;
    }

    .sn-cart-related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .sn-cart-hero__inner,
    .sn-cart-main__heading,
    .sn-cart-layout,
    .sn-cart-related__heading,
    .sn-cart-related__grid {
      width: calc(100% - 40px);
    }

    .sn-cart-title-row,
    .sn-cart-main__heading,
    .sn-cart-related__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .sn-cart-title-row h1 {
      font-size: 38px;
    }

    .sn-cart-item {
      grid-template-columns: 96px 1fr;
      align-items: start;
    }

    .sn-cart-item__image {
      width: 96px;
      height: 96px;
    }

    .sn-cart-quantity {
      grid-column: 2;
    }

    .sn-cart-item__price {
      grid-column: 2;
      justify-self: start;
    }

    .sn-cart-empty-note span {
      display: block;
      margin: 12px 0 0;
    }

    .sn-cart-related__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  const cartQuantityGroups = document.querySelectorAll('.sn-cart-quantity');

  cartQuantityGroups.forEach((group) => {
    const input = group.querySelector('[data-sn-cart-quantity]');
    const minus = group.querySelector('[data-sn-cart-minus]');
    const plus = group.querySelector('[data-sn-cart-plus]');

    if (!input || !minus || !plus) return;

    minus.addEventListener('click', () => {
      input.value = String(Math.max(0, Number(input.value || 0) - 1));
    });

    plus.addEventListener('click', () => {
      input.value = String(Number(input.value || 0) + 1);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
