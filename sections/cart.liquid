<section class="sn-cart-page full-width">
  <div class="sn-cart-hero">
    <div class="sn-cart-hero__inner">
      <nav class="sn-cart-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <span>Cart</span>
      </nav>

      <div class="sn-cart-title-row">
        <h1>Your Cart</h1>
        <span>{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
      </div>

      <p>Review your items before checkout. Shipping and taxes are calculated at checkout.</p>
    </div>
  </div>

  <div class="sn-cart-main">
    <div class="sn-cart-main__heading">
      <h2>Cart Items</h2>
      <a href="{{ routes.all_products_collection_url }}">Continue Shopping &rarr;</a>
    </div>

    <div class="sn-cart-layout">
      <div class="sn-cart-items">
        {% if cart.item_count > 0 %}
          <form class="sn-cart-form" action="{{ routes.cart_url }}" method="post">
            {% for item in cart.items %}
              {% liquid
                assign condition = item.product.metafields.custom.condition.value | default: item.product.metafields.custom.condition
                assign series = item.product.metafields.custom.series.value | default: item.product.metafields.custom.series | default: 'ONE PIECE'
                assign item_type = item.product.type | default: 'Anime Goods'

                if condition == blank
                  if item.product.tags contains 'condition_opened'
                    assign condition = 'Like New'
                  elsif item.product.tags contains 'condition_used'
                    assign condition = 'Good'
                  else
                    assign condition = 'New'
                  endif
                endif
              %}

              <article class="sn-cart-item">
                <a class="sn-cart-item__image" href="{{ item.url }}">
                  {% if item.image %}
                    {{ item.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </a>

                <div class="sn-cart-item__content">
                  <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                  <p class="sn-cart-item__meta">{{ item_type }} &middot; {{ series }} &middot; {{ condition }}</p>
                  <strong class="sn-cart-stock">
                    {% if item.variant.available %}
                      In Stock
                    {% else %}
                      Sold Out
                    {% endif %}
                  </strong>

                  <p class="sn-cart-item__price">{{ item.final_line_price | money }}</p>

                  <div class="sn-cart-item__actions">
                    <div class="sn-cart-quantity">
                      <button type="button" data-sn-cart-minus aria-label="Decrease quantity">-</button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        data-sn-cart-quantity
                        aria-label="Quantity for {{ item.product.title | escape }}"
                      >
                      <button type="button" data-sn-cart-plus aria-label="Increase quantity">+</button>
                    </div>

                    <a class="sn-cart-remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }}">
                      <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 15H6L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            {% endfor %}
          </form>
        {% else %}
          <div class="sn-cart-empty">
            <h3>Your cart is currently empty.</h3>
            <p>Items you add to your cart will appear here before checkout.</p>
            <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
          </div>
        {% endif %}

        <div class="sn-checkout-notes">
          <h2>Before checkout</h2>
          <p>100% Authentic goods</p>
          <p>Ships from Japan</p>
          <p>Import duties may apply</p>
        </div>
      </div>

      <aside class="sn-order-column">
        <form class="sn-order-summary" action="{{ routes.cart_url }}" method="post">
          <h2>Order Summary</h2>
          <dl>
            <div>
              <dt>Subtotal</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
            <div>
              <dt>Shipping</dt>
              <dd>Calculated at checkout</dd>
            </div>
            <div>
              <dt>Taxes / Customs</dt>
              <dd>May apply</dd>
            </div>
            <div class="sn-order-summary__total">
              <dt>Total</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
          </dl>

          <button type="submit" name="checkout" {% if cart.item_count == 0 %}disabled{% endif %}>Proceed to Checkout</button>
          <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
        </form>
      </aside>
    </div>
  </div>

  {% render 'sn-related-products' %}

  {% render 'sn-faq-cta',
    class: 'sn-cart-faq',
    heading: 'Questions before ordering?',
    text: 'Learn about authenticity, shipping, customs, and payment methods.',
    url: '/pages/faq',
    label: 'View FAQ'
  %}
</section>

{% stylesheet %}
  .sn-cart-page {
    --sn-pink: #e8a1bf;
    --sn-pink-soft: #fff5f8;
    --sn-pink-strong: #d67da6;
    --sn-ink: #1f1f1f;
    --sn-muted: #6b7380;
    --sn-body: #384052;
    --sn-line: #e5e8eb;
    --sn-cream: #faf7f2;
    font-family: var(--font-primary--family);
    color: var(--sn-ink);
    background: #fff;
  }

  .sn-cart-page a {
    text-decoration: none;
  }

  .sn-cart-hero {
    position: relative;
    overflow: hidden;
    background: var(--sn-cream);
  }

  .sn-cart-hero::after {
    content: '';
    position: absolute;
    top: -2.5rem;
    right: -1.25rem;
    width: 13.75rem;
    height: 13.75rem;
    border-radius: 62.44rem;
    background: rgba(232, 161, 191, 0.16);
  }

  .sn-cart-hero__inner {
    position: relative;
    z-index: 1;
    width: var(--sn-wide-content-width);
    min-height: 10.25rem;
    margin: 0 auto;
    padding: 1.75rem 0 2.125rem;
  }

  .sn-cart-breadcrumb {
    display: flex;
    gap: 0.5625rem;
    color: var(--sn-muted);
    font-size: 0.8125rem;
  }

  .sn-cart-title-row {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    margin-top: 0.75rem;
  }

  .sn-cart-title-row h1 {
    font-size: 2.75rem;
    line-height: 1.05;
    font-weight: 800;
  }

  .sn-cart-title-row span {
    color: var(--sn-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .sn-cart-hero__inner > p {
    margin-top: 0.5rem;
    color: var(--sn-body);
    font-size: 0.875rem;
  }

  .sn-cart-main {
    background: #fff;
  }

  .sn-cart-main__heading,
  .sn-cart-layout {
    width: var(--sn-wide-content-width);
    margin: 0 auto;
  }

  .sn-cart-main__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 3.5rem;
  }

  .sn-cart-main__heading h2 {
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .sn-cart-main__heading a {
    color: var(--sn-pink-strong);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .sn-cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 66.88rem) minmax(20rem, 25rem);
    gap: 2.5rem;
    padding: 1.75rem 0 3.375rem;
  }

  .sn-cart-form {
    display: grid;
    gap: 1.25rem;
  }

  .sn-cart-item {
    position: relative;
    min-height: 10.75rem;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    padding: 1.5rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
  }

  .sn-cart-item__image {
    height: 100%;
    min-height: 8rem;
    aspect-ratio: 1 / 1;
    display: block;
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.875rem;
    background: #f5f7fa;
  }

  .sn-cart-item__image img,
  .sn-cart-item__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-cart-item__content {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    padding-top: 0.125rem;
  }

  .sn-cart-item h3 {
    font-size: 1rem;
    line-height: 1.35;
  }

  .sn-cart-item h3 a {
    color: var(--sn-ink);
  }

  .sn-cart-item h3 a:hover,
  .sn-cart-item h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .sn-cart-item__meta {
    margin-top: 0.25rem;
    color: var(--sn-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .sn-cart-stock {
    display: block;
    margin-top: 0.25rem;
    color: #6b8f24;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .sn-cart-quantity {
    width: 7.25rem;
    height: 2rem;
    display: grid;
    grid-template-columns: 2.125rem 3rem 2.125rem;
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.5rem;
    background: #fff;
  }

  .sn-cart-quantity button,
  .sn-cart-quantity input {
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sn-ink);
    font: inherit;
    font-weight: 800;
    text-align: center;
  }

  .sn-cart-quantity button:focus-visible,
  .sn-cart-quantity input:focus-visible {
    box-shadow: inset 0 0 0 0.0625rem var(--sn-muted);
  }

  .sn-cart-quantity input::-webkit-outer-spin-button,
  .sn-cart-quantity input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sn-cart-item__actions {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.875rem;
  }

  .sn-cart-item__price {
    margin-top: 0.625rem;
    font-size: 1.5rem;
    line-height: 1.1;
    font-weight: 800;
  }

  .sn-cart-remove {
    margin-left: auto;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ff4f5e;
  }

  .sn-cart-remove svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .sn-cart-empty {
    width: 100%;
    padding: 1.5rem;
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
  }

  .sn-cart-empty {
    min-height: 11.75rem;
  }

  .sn-cart-empty h3 {
    font-size: 1.25rem;
  }

  .sn-cart-empty p {
    max-width: none;
    margin-top: 0.75rem;
    color: var(--sn-body);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .sn-cart-empty a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.125rem;
    padding: 0 1.75rem;
    border-radius: 0.375rem;
    background: var(--sn-pink);
    color: #fff;
    font-weight: 800;
  }

  .sn-order-column {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .sn-order-summary,
  .sn-checkout-notes {
    border: 0.0625rem solid var(--sn-line);
    border-radius: 0.375rem;
    background: #fff;
  }

  .sn-order-summary {
    padding: 1.5rem;
  }

  .sn-order-summary h2,
  .sn-checkout-notes h2 {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .sn-order-summary dl {
    margin-top: 1.125rem;
    padding-top: 1.125rem;
    border-top: 0.0625rem solid var(--sn-line);
  }

  .sn-order-summary div {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.6875rem 0;
    color: var(--sn-body);
    font-size: 0.875rem;
  }

  .sn-order-summary dd {
    color: var(--sn-muted);
    text-align: right;
  }

  .sn-order-summary div:first-child dd,
  .sn-order-summary__total dd,
  .sn-order-summary__total dt {
    color: var(--sn-ink);
    font-weight: 800;
  }

  .sn-order-summary__total {
    margin-top: 0.75rem;
    padding-top: 1.375rem !important;
    border-top: 0.0625rem solid var(--sn-line);
    font-size: 1rem !important;
  }

  .sn-order-summary__total dd {
    font-size: 1.5rem;
  }

  .sn-order-summary button,
  .sn-order-summary > a {
    width: 100%;
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .sn-order-summary button {
    margin-top: 1.125rem;
    border: 0.0625rem solid var(--sn-pink);
    background: var(--sn-pink);
    color: #fff;
    cursor: pointer;
  }

  .sn-order-summary button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .sn-order-summary > a {
    min-height: 2.75rem;
    margin-top: 0.75rem;
    border: 0.0625rem solid var(--sn-pink);
    color: var(--sn-pink-strong);
  }

  .sn-checkout-notes {
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: var(--sn-pink-soft);
  }

  .sn-checkout-notes p {
    margin-top: 0.75rem;
    color: var(--sn-body);
    font-size: 0.8125rem;
  }

  .sn-checkout-notes p::before {
    content: '\2713';
    margin-right: 0.5rem;
  }

  .sn-card-button {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(100% - 2.25rem);
    margin: 2.625rem 1.125rem 1.25rem;
    border: 0.125rem solid var(--sn-pink);
    border-radius: 0.375rem;
    color: var(--sn-pink);
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: 0 0.25rem 0.25rem rgba(232, 160, 191, 0.18);
  }

  .sn-cart-faq {
    padding: 3.625rem 1.25rem 3.375rem;
    background: #fff;
    text-align: center;
  }

  .sn-cart-faq h2 {
    font-size: 1.75rem;
  }

  .sn-cart-faq p {
    margin-top: 0.625rem;
    color: var(--sn-body);
    font-size: 0.875rem;
  }

  .sn-cart-faq a {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.25rem;
    padding: 0 1.875rem;
    border-radius: 0.375rem;
    background: var(--sn-pink);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
  }

  @media (max-width: 73.75rem) {
    .sn-cart-hero__inner,
    .sn-cart-main__heading,
    .sn-cart-layout {
      width: calc(100% - 4rem);
    }

    .sn-cart-layout {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 45rem) {
    .sn-cart-hero__inner,
    .sn-cart-main__heading,
    .sn-cart-layout {
      width: calc(100% - 2.5rem);
    }

    .sn-cart-title-row,
    .sn-cart-main__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .sn-cart-title-row h1 {
      font-size: 2.375rem;
    }

    .sn-cart-item {
      gap: 1rem;
      align-items: stretch;
      padding: 1.125rem;
    }

    .sn-cart-item__image {
      width: 6.75rem;
      min-height: 6.75rem;
    }

    .sn-cart-item__actions {
      gap: 0.75rem;
    }

  }
{% endstylesheet %}

{% javascript %}
  const cartQuantityGroups = document.querySelectorAll('.sn-cart-quantity');

  cartQuantityGroups.forEach((group) => {
    const input = group.querySelector('[data-sn-cart-quantity]');
    const minus = group.querySelector('[data-sn-cart-minus]');
    const plus = group.querySelector('[data-sn-cart-plus]');
    const form = group.closest('form');
    let updateTimer;

    if (!input || !minus || !plus || !form) return;

    const submitCartUpdate = () => {
      window.clearTimeout(updateTimer);

      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
        return;
      }

      form.submit();
    };

    const queueCartUpdate = () => {
      window.clearTimeout(updateTimer);
      updateTimer = window.setTimeout(submitCartUpdate, 500);
    };

    minus.addEventListener('click', () => {
      input.value = String(Math.max(0, Number(input.value || 0) - 1));
      submitCartUpdate();
    });

    plus.addEventListener('click', () => {
      input.value = String(Number(input.value || 0) + 1);
      submitCartUpdate();
    });

    input.addEventListener('change', queueCartUpdate);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
