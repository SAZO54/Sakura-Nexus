{% doc %}
  Renders a reusable Sakura Nexus product card.

  @param {product} product - Product to render
  @param {collection} [collection] - Optional collection context for product URLs
  @param {string} [card_class] - CSS class for the card root link
  @param {string} [image_class] - CSS class for the media element
  @param {string} [price_class] - CSS class for the price element
  @param {string} [stock_class] - CSS class for the stock element
  @param {string} [badge_class] - CSS class for the condition badge
  @param {number} [image_width] - Requested image width
  @param {boolean} [show_badge] - Whether to render a condition badge

  @example
  {% render 'sn-product-card', product: product, collection: collection %}
{% enddoc %}

{% liquid
  assign card_class = card_class | default: 'sn-product-card'
  if image_class == blank
    assign image_class = card_class | append: '__image'
  endif
  if price_class == blank
    assign price_class = card_class | append: '__price'
  endif
  if stock_class == blank
    assign stock_class = card_class | append: '__stock'
  endif
  assign badge_class = badge_class | default: 'sn-condition-badge'
  assign image_width = image_width | default: 544

  if collection
    assign product_url = product.url | within: collection
  else
    assign product_url = product.url
  endif
%}

<a class="{{ card_class }}" href="{{ product_url }}" aria-label="View details for {{ product.title | escape }}">
  <span class="{{ image_class }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: image_width | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}

    {% unless show_badge == false %}
      {% render 'sn-condition-badge', product: product, class: badge_class %}
    {% endunless %}
  </span>

  <h3>{{ product.title | escape }}</h3>
  <p class="{{ price_class }}">{{ product.price | money }}</p>
  <p class="{{ stock_class }}">
    {% if product.available %}
      In Stock
    {% else %}
      Sold Out
    {% endif %}
  </p>
</a>

{% stylesheet %}
  .sn-product-card {
    width: 100%;
    max-width: var(--sn-product-card-max-width, 18.75rem);
    aspect-ratio: var(--sn-product-card-ratio, 125 / 176);
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 0.0625rem solid var(--sn-line, #e5e7eb);
    border-radius: 0.375rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
  }

  .sn-product-card__image {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: var(--sn-product-card-image-ratio, 25 / 21);
    display: block;
    overflow: hidden;
    background: #f4f4f5;
  }

  .sn-product-card__image img,
  .sn-product-card__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-product-card h3 {
    margin: 1.125rem 1.125rem 0;
    min-height: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .sn-product-card__price {
    margin: 0.75rem 1.125rem 0;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .sn-product-card__stock {
    margin: 0.25rem 1.125rem 1.125rem;
    color: var(--sn-muted, #6b7280);
    font-size: 0.75rem;
  }

{% endstylesheet %}
