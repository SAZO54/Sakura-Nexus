{% doc %}
  Renders the shared Sakura Nexus FAQ call-to-action.

  @param {string} heading - CTA heading
  @param {string} text - CTA supporting text
  @param {string} url - CTA URL
  @param {string} label - CTA label
  @param {string} [class] - Wrapper CSS class

  @example
  {% render 'sn-faq-cta', heading: 'Questions?', text: 'Read the FAQ.', url: '/pages/faq', label: 'View FAQ' %}
{% enddoc %}

{% liquid
  assign cta_class = class | default: 'sn-faq-cta'
  assign label = label | default: 'View FAQ'
%}

<section class="{{ cta_class }}">
  {% if heading != blank %}
    <h2>{{ heading }}</h2>
  {% endif %}
  {% if text != blank %}
    <p>{{ text }}</p>
  {% endif %}
  {% if url != blank %}
    <a class="sn-button sn-button--primary" href="{{ url }}">{{ label }}</a>
  {% endif %}
</section>

{% stylesheet %}
  .sn-faq-cta {
    padding: 4.625rem 1.25rem;
    background: #fff;
    text-align: center;
  }

  .sn-faq-cta h2 {
    font-size: 1.875rem;
    line-height: 1.2;
  }

  .sn-faq-cta p {
    max-width: 45rem;
    margin: 0.875rem auto 0;
    color: var(--sn-muted, #6b7280);
    font-size: 0.9375rem;
  }

  .sn-faq-cta .sn-button {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.625rem;
    padding: 0 1.875rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sn-faq-cta .sn-button--primary {
    background: var(--sn-pink, #e8a0bf);
    color: #fff;
  }

  @media (max-width: 45rem) {
    .sn-faq-cta {
      padding-block: 3.5rem;
    }

    .sn-faq-cta h2 {
      font-size: 1.625rem;
    }
  }
{% endstylesheet %}
