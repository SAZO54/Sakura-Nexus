{% doc %}
  Renders a static related product card fallback for Sakura Nexus product pages.

  @param {string} asset_name - Asset filename to render as the product image
  @param {string} badge - Product condition badge text
  @param {string} title - Product title
  @param {string} price - Product price text

  @example
  {% render 'sn-related-placeholder', asset_name: 'sakura-product-card-set.jpg', badge: 'Good', title: 'ONE PIECE Card Set SP', price: '$36.00' %}
{% enddoc %}

<article class="sn-related-card">
  <a class="sn-related-card__image" href="{{ routes.all_products_collection_url }}">
    <img src="{{ asset_name | asset_url }}" alt="{{ title | escape }}" width="272" height="210" loading="lazy">
    <span class="sn-related-placeholder__badge sn-related-placeholder__badge--{{ badge | handleize }}">{{ badge }}</span>
  </a>
  <h3><a href="{{ routes.all_products_collection_url }}">{{ title }}</a></h3>
  <p class="sn-related-card__price">{{ price }}</p>
  <p class="sn-related-card__stock">In Stock</p>
  <a class="sn-card-button" href="{{ routes.all_products_collection_url }}">View Details</a>
</article>

{% stylesheet %}
  .sn-related-placeholder__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    min-height: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border-radius: 6px;
    background: #e8a1bf;
    color: #fff;
    font-size: 11px;
    line-height: 1;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sn-related-placeholder__badge--like-new {
    background: #f4c7d9;
    color: #7a294d;
  }

  .sn-related-placeholder__badge--very-good {
    background: #cee8ce;
    color: #215a21;
  }

  .sn-related-placeholder__badge--good {
    background: #7c9f32;
    color: #fff;
  }
{% endstylesheet %}
