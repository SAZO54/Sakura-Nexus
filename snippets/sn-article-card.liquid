{% doc %}
  Renders a Sakura Nexus article card for blog listings and article previews.

  @param {article} article - The article to render
  @param {string} [class] - Optional CSS class for the article wrapper
  @param {number} [image_width] - Image width used by the image_url filter
  @param {boolean} [show_excerpt] - Whether to render the article excerpt

  @example
  {% render 'sn-article-card', article: article %}
{% enddoc %}

{% liquid
  assign card_class = class | default: 'sn-article-card'
  assign image_width = image_width | default: 1000
%}

<article class="{{ card_class }}">
  {% if article.image %}
    <a class="{{ card_class }}__image" href="{{ article.url }}">
      {{ article.image | image_url: width: image_width | image_tag: loading: 'lazy', alt: article.image.alt | default: article.title }}
    </a>
  {% endif %}

  <div class="{{ card_class }}__content">
    <h2 class="{{ card_class }}__title">
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </h2>

    {% assign date = article.published_at | time_tag: format: 'date' %}
    <p class="{{ card_class }}__meta">
      {{ 'blog.article_metadata_html' | t: date: date, author: article.author }}
    </p>

    {% unless show_excerpt == false %}
      {% if article.excerpt != blank %}
        <p class="{{ card_class }}__excerpt">{{ article.excerpt | strip_html }}</p>
      {% endif %}
    {% endunless %}
  </div>
</article>

{% stylesheet %}
  .sn-article-card {
    overflow: hidden;
    border: 0.0625rem solid var(--sn-line, #e5e7eb);
    border-radius: 0.375rem;
    background: #fff;
  }

  .sn-article-card__image {
    display: block;
    height: 17.5rem;
    overflow: hidden;
    background: #f4f4f5;
  }

  .sn-article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sn-article-card__content {
    padding: 1.5rem;
  }

  .sn-article-card__title {
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 800;
  }

  .sn-article-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .sn-article-card__meta {
    margin-top: 0.625rem;
    color: var(--sn-muted, #6b7280);
    font-size: 0.8125rem;
  }

  .sn-article-card__excerpt {
    margin-top: 1rem;
    color: var(--sn-body, #374151);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
{% endstylesheet %}
